<?xml version="1.0" encoding="utf-8"?>
<!-- ==============================================================================
     LOTUS PLAYER - DIRECT EMBLEM ROUND ADAPTIVE LAUNCHER ICON (ZERO LINKING ERROR)
     File: android/app/src/main/res/mipmap-anydpi-v26/ic_launcher_round.xml
     
     POINTS DIRECTLY TO @drawable/lotus_splash_flower TO RESOLVE:
     "resource drawable/ic_launcher_foreground not found"
     Applies 16% safe inset to ensure the flower graphic is never clipped on
     Pixel, Samsung One UI, or Nubia MYOS 15 round circle launcher masks.
     ============================================================================== -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/lotus_launch_dark_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/lotus_app_icon"
            android:inset="16%" />
    </foreground>
</adaptive-icon>