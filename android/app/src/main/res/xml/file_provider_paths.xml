<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Maps external app files: Android/data/<pkg>/files/ -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Maps internal app files: /data/user/0/<pkg>/files/ -->
    <files-path
        name="internal_files"
        path="." />

    <!-- Maps temporary cache directories (used for artwork & shares) -->
    <cache-path
        name="internal_cache"
        path="." />

    <external-cache-path
        name="external_cache"
        path="." />

    <!-- Maps public storage root for sharing physical audio files -->
    <external-path
        name="external_storage"
        path="." />
</paths>